rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(org) {
      return request.auth != null
        && get(/databases/$(database)/documents/organizations/$(org)/members/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/organizations/$(org)/members/$(request.auth.uid)).data.role in ['BENDAHARA', 'KETUA'];
    }
    match /organizations/{org} {
      allow read: if member(org);
      allow write: if false;
      match /members/{uid} { allow read: if member(org) && uid == request.auth.uid; allow write: if false; }
      match /{collection}/{id} {
        allow read: if member(org) && collection in ['records', 'accounts', 'periods', 'auditEvents', 'reversals'];
        allow write: if false;
      }
      match /operationResults/{id} {
        allow read: if member(org) && resource.data.actorUid == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
