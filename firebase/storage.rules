rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function membership(org) {
      return firestore.get(/databases/(default)/documents/organizations/$(org)/members/$(request.auth.uid));
    }
    function member(org) {
      return request.auth != null && membership(org).data.active == true
        && membership(org).data.role in ['BENDAHARA', 'KETUA'];
    }
    match /organizations/{org}/receipts/{uid}/{operation}/receipt {
      allow read: if member(org) && (request.auth.uid == uid ||
        firestore.get(/databases/(default)/documents/organizations/$(org)/records/$(operation)).data.receiptPath
          == 'organizations/' + org + '/receipts/' + uid + '/' + operation + '/receipt');
      allow create: if resource == null && member(org) && request.auth.uid == uid
        && membership(org).data.role == 'BENDAHARA'
        && !firestore.exists(/databases/(default)/documents/organizations/$(org)/records/$(operation))
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete: if false;
    }
  }
}
